# ==================================================
# Universe HVAC Solutions — Frontend Environment Variables
# ==================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# Everything here is PUBLIC (safe to expose in the browser) — the frontend
# never holds a secret. All secrets live in backend/.env instead.

# The backend API's URL. In local development this is the Express server
# started with `npm run dev` inside backend/ (default port 4000). In
# production, set this to your deployed backend's URL.
NEXT_PUBLIC_API_URL=http://localhost:4000

NEXT_PUBLIC_COMPANY_NAME="Universe HVAC Solutions"
NEXT_PUBLIC_COMPANY_PHONE="9677098135"
NEXT_PUBLIC_WHATSAPP_NUMBER="919677098135"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
