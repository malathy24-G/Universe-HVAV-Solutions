# ==================================================
# Universe HVAC Solutions — Backend Environment Variables
# ==================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --------------------------------------------------
# SERVER
# --------------------------------------------------
PORT=4000
# Comma-separated list of frontend origins allowed to call this API.
# Add your deployed frontend URL here too, e.g.:
# FRONTEND_ORIGIN=http://localhost:3000,https://universehvac.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# --------------------------------------------------
# DATABASE (Supabase / PostgreSQL)
# --------------------------------------------------
# If these two are left blank, the API automatically falls back to local
# JSON files under backend/data/ so you can develop and test without a
# Supabase project. See docs/README.md "Database setup" for details.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------
# ADMIN AUTHENTICATION
# --------------------------------------------------
# Admin login email
ADMIN_EMAIL=admin@universehvac.example

# Bcrypt hash of the admin password — never store the plain password.
# Generate one with: npm run generate-admin-hash -- "YourPassword123"
ADMIN_PASSWORD_HASH=

# Random long secret used to sign admin session tokens (JWT).
# Generate one with: openssl rand -base64 48
ADMIN_JWT_SECRET=

# --------------------------------------------------
# COMPANY / NOTIFICATION TARGET
# --------------------------------------------------
# Where new-booking / contact-enquiry notification emails are sent
ADMIN_NOTIFICATION_EMAIL=

# --------------------------------------------------
# EMAIL (Resend)
# --------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Universe HVAC Solutions <bookings@yourdomain.com>"

# --------------------------------------------------
# WHATSAPP (WhatsApp Business Cloud API)
# --------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Admin's WhatsApp number that should receive new-booking alerts, in
# international format without "+", e.g. 919677098135
WHATSAPP_ADMIN_NUMBER=

# --------------------------------------------------
# SMS (provider-agnostic abstraction — see src/notifications/sms.ts)
# --------------------------------------------------
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
